// Bond Insight: data & analisis obligasi. Secret: SSO_SECRET, EDIT_KEY
// Tanpa cron sendiri (batas paket gratis 5 cron per akun): apps/cron memanggil /__cron 2x sehari (kurva PHEI & data obligasi), selain itu diperbarui saat halaman dibuka.
{
  "name": "bond-insight",
  "main": "worker.js",
  "compatibility_date": "2026-09-22",
  "kv_namespaces": [{ "binding": "BONDS_KV", "id": "auto" }]
}
