// Tool Hub: satu pintu login, admin, dan hak akses semua tool.
// Secret: SSO_SECRET (wajib), GITHUB_TOKEN & FIREBASE_SA (opsional, tab Tutorial). Lihat .secrets.example.json
// RECAP / PLANNER / FUND / COMPETITOR / EDUKASI / NEWS / ETF / BOND / CRON = service binding untuk ringkasan "Hari ini" dan status cron
// di beranda (shared/hubfeed.js); karena itu hub di-deploy paling akhir (lihat urutan di scripts/deploy.mjs).
{
  "name": "tool-hub",
  "main": "worker.js",
  "compatibility_date": "2026-09-22",
  "kv_namespaces": [{ "binding": "HUB_KV", "id": "auto" }],
  "services": [
    { "binding": "RECAP", "service": "market-recap" },
    { "binding": "PLANNER", "service": "content-planner" },
    { "binding": "FUND", "service": "fund-insight" },
    { "binding": "COMPETITOR", "service": "competitor-intel" },
    { "binding": "EDUKASI", "service": "edukasi-studio" },
    { "binding": "NEWS", "service": "market-news" },
    { "binding": "ETF", "service": "etf-insight" },
    { "binding": "BOND", "service": "bond-insight" },
    { "binding": "CRON", "service": "tool-cron" },
    // Event & Lead: menerima anggota, cabang, dan tim & role (sama seperti Planner)
    { "binding": "EVENT", "service": "event" }
  ]
}
