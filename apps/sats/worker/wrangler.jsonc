// SATS Radar: sinyal & screener saham. API + tampilan React (../frontend/dist) dalam satu worker.
// Secret: SSO_SECRET, GITHUB_TOKEN (memicu workflow sats-eod). Build tampilan dulu: npm --prefix ../frontend run build
{
  "name": "sats-radar",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-22",
  // apps/cron memanggil 10:20 & 12:20 UTC (17:20 & 19:20 WIB) Senin–Jumat: picu workflow EOD (jalan kedua = cadangan)
  "triggers": { "crons": [] },
  "vars": { "LOGIN": "hub" },
  // "/" (index.html) lewat worker dulu untuk header CSP frame-ancestors dari HUB_URL; aset lain dilayani langsung
  "assets": { "directory": "../frontend/dist", "binding": "ASSETS", "run_worker_first": ["/", "/index.html"] },
  "d1_databases": [{ "binding": "screener_db", "database_name": "sats-db", "database_id": "auto" }]
}
