// Salin menjadi .secrets.json lalu isi, kemudian: node scripts/deploy.mjs secrets
// .secrets.json TIDAK masuk repo. "*" dikirim ke semua tool; kunci lain = id tool (lihat APPS di scripts/deploy.mjs).
{
  "*": {
    "SSO_SECRET": "",         // teks acak min. 32 karakter, sama untuk semua tool
    "GEMINI_API_KEY": "",     // opsional, gratis (aistudio.google.com): AI semua tool lewat shared/ai.js
    "GROQ_API_KEY": ""        // opsional, gratis (console.groq.com): cadangan bila kuota Gemini habis
  },
  "hub": { "GITHUB_TOKEN": "", "FIREBASE_SA": "" },
  "fund": { "ADMIN_KEY": "", "NOTIFY_WEBHOOK": "" },
  "competitor": { "ADMIN_KEY": "" },
  "bond": { "EDIT_KEY": "" },
  "edukasi": { "ANTHROPIC_API_KEY": "" },
  "recap": { "ANTHROPIC_API_KEY": "" },   // opsional; kosong = Workers AI
  "content": { "ANTHROPIC_API_KEY": "" }, // opsional (konsep konten); kosong = Workers AI
  "news": { "GEMINI_API_KEY": "" },       // opsional (ringkasan berita); kosong = Workers AI
  "copy": { "GEMINI_API_KEY": "" },       // opsional (Copy Studio); kosong = Workers AI
  "storydata": { "GH_TOKEN": "" },
  "sats": { "GITHUB_TOKEN": "" }
}
